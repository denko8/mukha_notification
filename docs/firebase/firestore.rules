rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Личные заметки: только владелец.
    match /users/{uid}/{document=**} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    // Семья: чтение/запись только для участников (раздел 7 ТЗ).
    match /families/{familyId} {
      function isMember() {
        return signedIn() &&
          request.auth.uid in resource.data.members;
      }
      allow read: if isMember();
      allow update: if isMember();
      allow create: if signedIn();

      match /notes/{noteId} {
        allow read, write: if signedIn() &&
          request.auth.uid in
            get(/databases/$(database)/documents/families/$(familyId)).data.members;
      }
    }

    // Инвайт читается по токену, создаётся автором семьи.
    match /invites/{token} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.authorId == request.auth.uid;
    }
  }
}
