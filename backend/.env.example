# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# Use a hex value (URL-safe in DATABASE_URL). Never commit the real .env.
POSTGRES_PASSWORD=
# Only needed for compose.vps.yaml; domain must point at the VPS.
API_DOMAIN=
ACME_EMAIL=

# Private EXTERNAL S3-compatible object storage. Not a public bucket!
# Leave empty to keep text sync usable; new cloud file uploads return unavailable.
S3_ENDPOINT_URL=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
